{
  "name": "bridgeboard",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Bridgeboard — dark-glass strategy board for the Bridge Work AI Lab",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --experimental-specifier-resolution=node --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
